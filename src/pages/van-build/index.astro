---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const sections = (await getCollection('build'))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="The Van Build"
  description="A detailed look at how we built out our camper van for overlanding — from shell to electrical to the finishing touches."
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-5xl font-bold mb-6">The build</h1>
      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <p class="text-xl text-[rgb(var(--color-text-muted))] flex-1">
          There are already many excellent step-by-step van build guides online as well as YouTube channels full of build videos. We're not trying to replicate those here, we're trying to do two things. First, give you some evidence that non-professionals can build a DIY camper van and get decent results. Second, we want to give insight into our decisions: what we chose, why, whether it worked, and what we'd change. 
        </p>
        <img
          src="/images/van-build/build-hero-800.jpg"
          alt="The finished van build"
          class="w-full sm:w-80 rounded-lg object-cover aspect-[4/3] flex-shrink-0"
        />
      </div>
    </header>

    <nav class="space-y-3">
      {sections.map((section) => (
        <a
          href={`/van-build/${section.slug}`}
          class="group flex items-start gap-4 p-5 border border-[rgb(var(--color-border))] rounded-lg hover:border-[rgb(var(--color-accent))] transition-colors"
        >
          <span class="text-2xl font-bold text-[rgb(var(--color-border))] group-hover:text-[rgb(var(--color-accent))] transition-colors tabular-nums">
            {String(section.data.order).padStart(2, '0')}
          </span>
          <div>
            <h2 class="text-xl font-bold mb-1 group-hover:text-[rgb(var(--color-accent))] transition-colors">
              {section.data.title}
            </h2>
            <p class="text-[rgb(var(--color-text-muted))] text-sm">{section.data.description}</p>
          </div>
        </a>
      ))}
    </nav>
  </div>
</Layout>
